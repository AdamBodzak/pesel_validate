{% extends 'base.html.twig' %}

{% block title %}{{ 'person.register.title'|trans }} – {{ parent() }}{% endblock %}

{% block body %}
    {% set pesel_hint_config = {
        decodeUrl: path('pesel_decode'),
        csrfToken: csrf_token(pesel_decode_csrf_token_id),
        birthDateId: form.birthDate.vars.id,
        genderName: form.gender.vars.full_name,
    } %}

    <section class="mx-auto max-w-xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h1 class="mb-6 text-2xl font-semibold">{{ 'person.register.title'|trans }}</h1>

        {# novalidate: validation messages come from the server, in Polish and consistent with the domain rules #}
        {{ form_start(form, {attr: {
            novalidate: 'novalidate',
            'x-data': 'peselHint(' ~ pesel_hint_config|json_encode ~ ')',
            'x-on:change': 'syncFields()',
            'x-on:submit': 'submitting = true',
        }}) }}
            {{ form_errors(form) }}

            {{ form_row(form.firstName) }}
            {{ form_row(form.lastName) }}
            {# merge keeps the attributes defined in RegisterPersonFormType (inputmode, autocomplete) #}
            {{ form_row(form.pesel, {attr: form.pesel.vars.attr|merge({
                'data-pesel-input': '',
                'x-on:input.debounce.300ms': 'decode($event.target.value)',
            })}) }}

            <div aria-live="polite">
                <div x-cloak x-show="decoded" class="-mt-3 mb-5 rounded-md bg-indigo-50 px-3 py-2 text-sm text-indigo-900">
                    <div class="flex items-center justify-between gap-4">
                        <span x-text="decoded && decoded.hint"></span>
                        <button
                            type="button"
                            class="shrink-0 rounded-md border border-indigo-200 bg-white px-3 py-1 font-medium text-indigo-700 hover:bg-indigo-100"
                            x-on:click="fill()"
                        >{{ 'person.pesel_hint.fill'|trans }}</button>
                    </div>
                    <p x-show="mismatch" class="mt-2 text-amber-700">{{ 'person.pesel_hint.mismatch'|trans }}</p>
                </div>
                <p x-cloak x-show="error" x-text="error" class="-mt-3 mb-5 text-sm text-red-600"></p>
            </div>

            {{ form_row(form.birthDate) }}
            {{ form_row(form.gender) }}

            <button
                type="submit"
                class="w-full rounded-md bg-indigo-600 px-4 py-2 font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-300 disabled:cursor-not-allowed disabled:opacity-60"
                x-bind:disabled="submitting"
            >{{ 'person.register.submit'|trans }}</button>
        {{ form_end(form) }}
    </section>
{% endblock %}
