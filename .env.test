# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Fail on deprecations triggered by our code (self) or by our direct calls to libraries (direct);
# silence deprecations between vendor packages (indirect), e.g. Symfony 5.4 calling deprecated Twig API
SYMFONY_DEPRECATIONS_HELPER='max[self]=0&max[direct]=0&quiet[]=indirect'
